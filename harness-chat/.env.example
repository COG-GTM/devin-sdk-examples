# Devin personal access token (app.devin.ai → Settings → API keys).
DEVIN_API_KEY=cog_…

# Everything else comes from `vercel env pull` after `vercel link`:
#   VERCEL_OIDC_TOKEN      — Vercel Sandbox auth (automatic when deployed)
#   KV_REST_API_URL        — Upstash Redis from the Vercel integration:
#   KV_REST_API_TOKEN        session records, transcripts and resume state
#   REDIS_URL              — same Upstash database, used by resumable streams (pub/sub)
